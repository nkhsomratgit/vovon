const loginPage = document.getElementById("loginPage");
const dashboard = document.getElementById("dashboard");

const loginForm = document.getElementById("loginForm");
const loginMessage = document.getElementById("loginMessage");

const logoutButton = document.getElementById("logoutButton");

const songForm = document.getElementById("songForm");
const photoForm = document.getElementById("photoForm");

const songStatus = document.getElementById("songStatus");
const photoStatus = document.getElementById("photoStatus");

const songSubmit = document.getElementById("songSubmit");
const photoSubmit = document.getElementById("photoSubmit");

const totalSongs = document.getElementById("totalSongs");
const totalPhotos = document.getElementById("totalPhotos");


// =====================================================
// SHOW DASHBOARD
// =====================================================

function showDashboard() {

    loginPage.classList.add("hidden");

    dashboard.classList.remove("hidden");

    loadDashboard();

}


// =====================================================
// SHOW LOGIN
// =====================================================

function showLogin() {

    dashboard.classList.add("hidden");

    loginPage.classList.remove("hidden");

}


// =====================================================
// LOGIN
// =====================================================

loginForm.addEventListener("submit", async function (e) {

    e.preventDefault();

    loginMessage.textContent = "Login হচ্ছে...";

    const username =
        document.getElementById("username").value.trim();

    const password =
        document.getElementById("password").value;

    try {

        const response = await fetch("/api/login", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({
                username: username,
                password: password
            })

        });

        const data = await response.json();

        if (data.success) {

            loginMessage.textContent = "";

            showDashboard();

        } else {

            loginMessage.textContent =
                data.message || "Login ব্যর্থ হয়েছে";

        }

    } catch (error) {

        console.error(error);

        loginMessage.textContent =
            "Server-এর সাথে যোগাযোগ করা যাচ্ছে না।";

    }

});


// =====================================================
// LOGOUT
// =====================================================

logoutButton.addEventListener("click", async function () {

    try {

        await fetch("/api/logout", {
            method: "POST"
        });

    } catch (error) {

        console.error(error);

    }

    showLogin();

});


// =====================================================
// LOAD DASHBOARD
// =====================================================

async function loadDashboard() {

    await loadSongs();

    await loadPhotos();

}


// =====================================================
// LOAD SONGS
// =====================================================

async function loadSongs() {

    try {

        const response =
            await fetch("/api/songs");

        if (!response.ok) {

            if (response.status === 401) {
                showLogin();
            }

            return;

        }

        const songs =
            await response.json();

        totalSongs.textContent =
            songs.length;

        renderSongs(songs);

    } catch (error) {

        console.error(
            "Songs loading error:",
            error
        );

    }

}


// =====================================================
// LOAD PHOTOS
// =====================================================

async function loadPhotos() {

    try {

        const response =
            await fetch("/api/photos");

        if (!response.ok) {

            if (response.status === 401) {
                showLogin();
            }

            return;

        }

        const photos =
            await response.json();

        totalPhotos.textContent =
            photos.length;

        renderPhotos(photos);

    } catch (error) {

        console.error(
            "Photos loading error:",
            error
        );

    }

}


// =====================================================
// RENDER SONGS
// =====================================================

function renderSongs(songs) {

    const container =
        document.getElementById("songList");

    if (!container) return;

    container.innerHTML = "";

    if (!songs.length) {

        container.innerHTML = `
            <div class="empty">
                এখনো কোনো গান যোগ করা হয়নি।
            </div>
        `;

        return;
    }

    songs.forEach(song => {

        const item =
            document.createElement("div");

        item.className = "item";

        item.innerHTML = `

            <div class="item-thumb">

                ${
                    song.cover
                    ? `<img
                        src="${song.cover}"
                        alt=""
                    >`
                    : "♪"
                }

            </div>

            <div class="item-info">

                <strong>
                    ${escapeHTML(song.title)}
                </strong>

                <span>
                    ${escapeHTML(
                        song.artist || "আশিক ভবন"
                    )}
                </span>

            </div>

            <button
                class="delete-button"
                onclick="deleteSong(${song.id})"
            >
                🗑️ Remove
            </button>

        `;

        container.appendChild(item);

    });

}


// =====================================================
// RENDER PHOTOS
// =====================================================

function renderPhotos(photos) {

    const container =
        document.getElementById("photoList");

    if (!container) return;

    container.innerHTML = "";

    if (!photos.length) {

        container.innerHTML = `
            <div class="empty">
                এখনো কোনো ছবি যোগ করা হয়নি।
            </div>
        `;

        return;
    }

    photos.forEach(photo => {

        const item =
            document.createElement("div");

        item.className = "item";

        item.innerHTML = `

            <div class="item-thumb">

                <img
                    src="${photo.image}"
                    alt=""
                >

            </div>

            <div class="item-info">

                <strong>
                    ${escapeHTML(
                        photo.title || "আশিক ভবন"
                    )}
                </strong>

                <span>
                    Gallery Photo
                </span>

            </div>

            <button
                class="delete-button"
                onclick="deletePhoto(${photo.id})"
            >
                🗑️ Remove
            </button>

        `;

        container.appendChild(item);

    });

}


// =====================================================
// HTML SAFE TEXT
// =====================================================

function escapeHTML(value) {

    const div =
        document.createElement("div");

    div.textContent =
        value == null ? "" : value;

    return div.innerHTML;

