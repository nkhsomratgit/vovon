// =====================================================
// ADD SONG
// =====================================================

songForm.addEventListener("submit", async function (e) {

    e.preventDefault();

    songStatus.textContent = "গান আপলোড হচ্ছে...";
    songSubmit.disabled = true;

    try {

        const formData =
            new FormData(songForm);

        const response =
            await fetch("/api/songs", {
                method: "POST",
                body: formData
            });

        const data =
            await response.json();

        if (!response.ok || !data.success) {

            throw new Error(
                data.message || "গান আপলোড হয়নি"
            );

        }

        songStatus.textContent =
            "✅ গান সফলভাবে যোগ হয়েছে!";

        songForm.reset();

        const artistInput =
            songForm.querySelector(
                '[name="artist"]'
            );

        if (artistInput) {
            artistInput.value = "আশিক ভবন";
        }

        await loadSongs();

    } catch (error) {

        console.error(error);

        songStatus.textContent =
            "❌ " + error.message;

    } finally {

        songSubmit.disabled = false;

    }

});


// =====================================================
// ADD PHOTO
// =====================================================

photoForm.addEventListener("submit", async function (e) {

    e.preventDefault();

    photoStatus.textContent =
        "ছবি আপলোড হচ্ছে...";

    photoSubmit.disabled = true;

    try {

        const formData =
            new FormData(photoForm);

        const response =
            await fetch("/api/photos", {
                method: "POST",
                body: formData
            });

        const data =
            await response.json();

        if (!response.ok || !data.success) {

            throw new Error(
                data.message || "ছবি আপলোড হয়নি"
            );

        }

        photoStatus.textContent =
            "✅ ছবি সফলভাবে যোগ হয়েছে!";

        photoForm.reset();

        await loadPhotos();

    } catch (error) {

        console.error(error);

        photoStatus.textContent =
            "❌ " + error.message;

    } finally {

        photoSubmit.disabled = false;

    }

});


// =====================================================
// DELETE SONG
// =====================================================

async function deleteSong(id) {

    const confirmDelete =
        confirm(
            "এই গানটি কি সত্যিই Remove করতে চান?"
        );

    if (!confirmDelete) return;

    try {

        const response =
            await fetch(
                "/api/songs/" + id,
                {
                    method: "DELETE"
                }
            );

        const data =
            await response.json();

        if (!response.ok || !data.success) {

            throw new Error(
                data.message ||
                "গান Remove করা যায়নি"
            );

        }

        await loadSongs();

    } catch (error) {

        console.error(error);

        alert(
            "❌ " + error.message
        );

    }

}


