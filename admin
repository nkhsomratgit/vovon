// =====================================================
// CHECK LOGIN
// =====================================================

async function checkLogin() {

    try {

        const response =
            await fetch("/api/songs");

        if (response.status === 401) {

            showLogin();

            return;

        }

        if (response.ok) {

            showDashboard();

        }

    } catch (error) {

        console.error(
            "Connection error:",
            error
        );

    }

}


// =====================================================
// START ADMIN PANEL
// =====================================================

document.addEventListener(
    "DOMContentLoaded",
    function () {

        checkLogin();

    }
);
